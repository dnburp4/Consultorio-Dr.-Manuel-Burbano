---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Consultorio del Dr. Manuel Burbano, especialista en neuropediatría y electroencefalografía.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/images/favicon_dr_burbano.png" type="image/png" sizes="512x512" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CookieConsent />

    <script is:inline>
      // Seguimiento de conversiones por delegación de eventos.
      // Cualquier elemento con data-ga-event envía un evento a GA4 al hacer clic.
      // Solo se dispara si GA está cargado (window.gtag existe = hubo consentimiento).
      document.addEventListener("click", function (e) {
        const el = e.target.closest("[data-ga-event]");
        if (!el) return;
        if (typeof window.gtag !== "function") return;

        const params = {};
        if (el.dataset.gaMethod) params.method = el.dataset.gaMethod;
        window.gtag("event", el.dataset.gaEvent, params);
      });
    </script>
  </body>
</html>
