---
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterLegal from "../components/FooterLegal.astro";
import Header from "../components/Header.astro";
---

<BaseLayout
  title="Consultorio Dr. Manuel Burbano | Neuropediatría y EEG"
  description="Consultorio del Dr. Manuel Burbano, especialista en neuropediatría y electroencefalografía. Atención profesional a niños y adolescentes con trastornos neurológicos, del desarrollo y del sueño."
>
  <Header />

  <h1>Dr. Manuel Burbano</h1>
  <h2>Especialista en Neuropediatría-Electroencefalografía</h2>

  <div id="button-container">
    <a href="tel:+593999456700">
      <button>AGENDAR CITA</button>
    </a>
  </div>

  <div class="imagen-banner">
    <img src="/images/foto-cerebro.jpg" alt="Cerebro humano estilizado" />
  </div>

  <div id="text-container">
    <h2>Atención especializada</h2>

    <ul>
      <li>
        <strong>Consulta Neuropediátrica</strong>

        <li>Atención a recién nacidos y lactantes de alto riesgo neurológico</li>
        <li>Retraso del desarrollo psicomotor</li>
        <li>
          <strong>Trastornos del neurodesarrollo:</strong>
          <ul>
            <br />
            <li>TDAH (Trastorno por déficit de atención/hiperactividad)</li>
            <li>Trastornos del lenguaje y del aprendizaje</li>
            <li>Trastorno del espectro autista (TEA)</li>
          </ul>
        </li>
        <br />
        <li>Convulsiones febriles</li>
        <li>Epilepsia</li>
        <li>Cefalea</li>
        <li>Traumatismos craneales</li>
        <li>Trastornos del sueño</li>
        <li>Trastornos neurológicos en niños y adolescentes</li>
      </li>

      <li><strong>Procedimientos de electroencefalografía (EEG)</strong></li>
    </ul>
  </div>

  <div id="contact-container">
    <h2>Contacto</h2>

    <a href="tel:+593999456700"> Celular: 0999456700 </a>

    <a href="tel:+59322378860">
      <i class="fa-solid fa-phone"></i>
      Teléfono: 2378860
    </a>

    <a href="https://wa.me/593999456700" target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-whatsapp"></i>WhatsApp</a
    >
  </div>

  <div id="line-separator"></div>

  <div class="direccion-container">
    <h2>Dirección</h2>
    <p>Edificio de Especialidades Médicas - Consultorio 214</p>
    <p>Av. Interoceánica km 12.5 y Av. Florencia</p>

    <div class="mapa-responsive">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.7919125811354!2d-78.4251735!3d-0.20846209999999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91d5913579469159%3A0x746e1fc3f55b94c4!2sDr.%20Manuel%20Burbano%20-%20Neuropediatra!5e0!3m2!1ses-419!2sec!4v1760551778386!5m2!1ses-419!2sec"
        width="600"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>

  <FooterLegal />
</BaseLayout>
